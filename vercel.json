{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "echo 'docs/ is built locally by tools/build_all.sh and committed; nothing to build'",
  "ignoreCommand": "node tools/vercel/gate.mjs",
  "outputDirectory": "docs",
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/sf-corridor-3d.html",
      "destination": "/#install",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/regions/:region",
      "destination": "/#install",
      "permanent": true
    },
    {
      "source": "/regions/:region/",
      "destination": "/#install",
      "permanent": true
    },
    {
      "source": "/regions/:region/index.html",
      "destination": "/#install",
      "permanent": true
    },
    {
      "source": "/regions/:region/sf-corridor-3d.html",
      "destination": "/#install",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/(.*)\\.glb",
      "headers": [
        {
          "key": "Content-Type",
          "value": "model/gltf-binary"
        }
      ]
    },
    {
      "source": "/tiles/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
