# The controller's settings. Copy to cloud/config/controller.env (gitignored) and fill in.
# Never paste these into chat or commit them. cloud/docs/secrets.md says what each one may do.
# Load into a shell with:  set -a; source cloud/config/controller.env; set +a
KERBSIDE_SECRET=                 # signs worker tokens:            openssl rand -hex 32
KERBSIDE_OPS_TOKEN=              # the dashboard and operator commands: openssl rand -hex 24
# Leave unset on RunPod: the controller uses its pod's proxy address. Operator commands on the
# Mac need it, after `smc-cloud runpod-controller create` prints it.
KERBSIDE_CONTROLLER_URL=
RUNPOD_API_KEY=                  # RunPod API key (Settings > API Keys); read/write for pods
AWS_REGION=us-west-2             # the region both buckets are in
S3_PRIVATE_BUCKET=kerbside
S3_PRIVATE_ACCESS_KEY_ID=        # IAM user: read/write/list on kerbside only
S3_PRIVATE_SECRET_ACCESS_KEY=
S3_PUBLIC_BUCKET=kerbside-finished-map
S3_PUBLIC_ACCESS_KEY_ID=         # IAM user: read/write/list on kerbside-finished-map only (controller only)
S3_PUBLIC_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE=https://dxxxxxxxxxxxx.cloudfront.net   # CloudFront in front of kerbside-finished-map
MAPILLARY_ACCESS_TOKEN=          # imagery stage and house filter
MAPILLARY_TOKEN=
HUGGINGFACE_TOKEN=               # model downloads (read-only token)
GITHUB_TOKEN=                    # site promotion only, on the Mac: fine-grained, this repo, contents + pull requests
# For operator commands on the Mac (migrate, promote):
KERBSIDE_PRIVATE_STORE=s3://kerbside
KERBSIDE_PUBLIC_STORE=s3://kerbside-finished-map
KERBSIDE_PUBLIC_BASE=https://dxxxxxxxxxxxx.cloudfront.net
