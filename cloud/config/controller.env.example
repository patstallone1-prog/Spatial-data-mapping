# The controller's secrets. Copy to cloud/config/controller.env (gitignored), fill in, and
# push with cloud/deploy/push-secrets.sh. cloud/docs/secrets.md says what each one may do.
KERBSIDE_SECRET=                 # 32+ random bytes: signs worker tokens (openssl rand -hex 32)
KERBSIDE_OPS_TOKEN=              # the dashboard and operator commands (openssl rand -hex 24)
KERBSIDE_CONTROLLER_URL=https://control.example.org
HCLOUD_TOKEN=                    # Hetzner project token, read & write (servers only)
RUNPOD_API_KEY=                  # RunPod key, pods only
R2_ACCOUNT_ID=
R2_PRIVATE_BUCKET=kerbside-private
R2_PRIVATE_ACCESS_KEY_ID=        # R2 token: Object Read & Write on kerbside-private only
R2_PRIVATE_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=kerbside-public
R2_PUBLIC_ACCESS_KEY_ID=         # R2 token: Object Read & Write on kerbside-public only (controller only)
R2_PUBLIC_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE=https://assets.example.org
MAPILLARY_ACCESS_TOKEN=          # imagery stage and house filter
MAPILLARY_TOKEN=
HUGGINGFACE_TOKEN=               # model downloads (read-only token)
GITHUB_TOKEN=                    # site promotion: fine-grained, this repository, contents + pull requests
