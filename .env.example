# Copy to .env.local (gitignored) and fill in. `python -m smc.adapters check` reports state.

# Required
HUGGINGFACE_TOKEN=
SMC_DATABASE_URL=postgresql://localhost:5432/smc
SMC_OBJECT_STORE_URL=gs://your-bucket

# Supabase storage for the web app. ONLY the publishable key belongs in client code:
# secret and service_role keys bypass row-level security and must never ship in a page.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional
GOOGLE_CLOUD_PROJECT=
MAPILLARY_ACCESS_TOKEN=
PANORAMAX_ENDPOINT=
RTK2GO_MOUNTPOINT=
