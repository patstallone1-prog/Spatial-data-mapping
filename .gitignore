
# Personal capture sets: test fixtures, not source.
*.pem
*.pyc
.env
.env.local
.mypy_cache/
.pytest_cache/
.ruff_cache/
.venv/
__pycache__/
build/
.cache/kerbside/
photos/
data/captures/quarantine/
data/captures/*/images/
