build/release_assets/
graphify-out/20*/
graphify-out/cache/ast/

# Harvest working files. The journal is a crash-recovery log written every 250 frames so an
# interrupted crawl resumes rather than starting again; the parquet beside it is the actual
# catalogue. Mapillary's reached 171 MB, over GitHub's file limit, and versioning a recovery
# log is not what it is for.
**/observations/journal.jsonl
**/observations/boxes_done.txt

# The knowledge graph is regenerated by `graphify update .` and nothing outside this machine
# reads it. Committed, it cost 59 MB of history for two files that change on every run.
graphify-out/

# Derived from the provider catalogues by tools/refresh_catalog.sh. Committing the merge, the
# depth store and the OSM cache added roughly 55 MB of undedupable binary per deploy, all of it
# reproducible from data/sf_corridor_*/observations/*.parquet, which are kept.
data/sf_corridor/

# Source frames fetched to build facades. Gigabytes of other people's JPEGs, rebuildable
# from the catalogue at any time, and none of it belongs in a clone.
build/facade-cache/

# Raw DataSF responses. Reproducible cache keyed by dataset and query; the derived tables
# under data/sf_public_works/ are what belongs in the repository.
build/sf_public_works/
